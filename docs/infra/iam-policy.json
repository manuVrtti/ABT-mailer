{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SESSendOnly",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendBulkEmail"],
      "Resource": [
        "arn:aws:ses:ap-south-1:*:identity/mail.abtalks.in",
        "arn:aws:ses:ap-south-1:*:identity/abtalks.in",
        "arn:aws:ses:ap-south-1:*:configuration-set/abtalks-mailer"
      ]
    },
    {
      "Sid": "SESReadQuota",
      "Effect": "Allow",
      "Action": ["ses:GetAccount", "ses:GetSendQuota", "ses:ListSuppressedDestinations"],
      "Resource": "*"
    }
  ]
}
