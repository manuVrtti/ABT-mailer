// ABTalks Email Infrastructure — Prisma schema.
//
// Design principles:
//   * One shared pipeline for MARKETING and TRANSACTIONAL email. EmailJob is
//     the single unit of work for both. `emailType` is the discriminator.
//   * `Suppression` is category-aware: unsubscribing from marketing does not
//     block essential transactional (password reset, security).
//   * Every EmailJob has an `idempotencyKey` UNIQUE — retries never send twice.
//   * Registered ABTalks users are NOT copied; `RegisteredUserRef` is a thin
//     projection keyed by their upstream id. The ABTalks DB stays source of
//     truth (read-only bridge via ABTALKS_DB_URL).
//   * Every marketing send is filtered server-side against Suppression before
//     touching SES.
//
// Naming: table names are snake_case via @@map so the DB is readable in psql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MARKETER
  VIEWER

  @@map("role")
}

enum EmailCategory {
  MARKETING
  TRANSACTIONAL_NONESSENTIAL
  TRANSACTIONAL_ESSENTIAL

  @@map("email_category")
}

enum EmailType {
  MARKETING
  TRANSACTIONAL

  @@map("email_type")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENDING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED

  @@map("campaign_status")
}

enum EmailJobStatus {
  PENDING
  QUEUED
  SENDING
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
  SKIPPED

  @@map("email_job_status")
}

enum EmailEventType {
  SEND
  DELIVERY
  BOUNCE
  COMPLAINT
  OPEN
  CLICK
  REJECT
  RENDERING_FAILURE

  @@map("email_event_type")
}

enum SuppressionReason {
  UNSUBSCRIBE
  HARD_BOUNCE
  COMPLAINT
  MANUAL

  @@map("suppression_reason")
}

enum ConsentStatus {
  UNKNOWN
  IMPLIED
  EXPLICIT
  WITHDRAWN

  @@map("consent_status")
}

enum ContactSource {
  IMPORT
  MANUAL
  API
  ABTALKS_USER

  @@map("contact_source")
}

// STATIC lists are filled by hand / CSV. KLYMB lists are live: their members
// are recomputed from the Klymb database by `klymbFilter` on every refresh.
enum ContactListKind {
  STATIC
  KLYMB

  @@map("contact_list_kind")
}

enum ListOverrideMode {
  INCLUDE
  EXCLUDE

  @@map("list_override_mode")
}

// Personal mails: one CSV row = one hand-written email to one address.
enum DirectSendStatus {
  DRAFT
  SENDING
  COMPLETED
  CANCELLED

  @@map("direct_send_status")
}

// PERSONAL is one-to-one mail (no unsubscribe footer, transactional category);
// MARKETING adds the unsubscribe footer + header and honours marketing opt-outs.
enum DirectSendKind {
  PERSONAL
  MARKETING

  @@map("direct_send_kind")
}

enum ImportJobStatus {
  PENDING
  PARSING
  VALIDATING
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED

  @@map("import_job_status")
}

enum ConversionStage {
  CLICK
  REGISTRATION
  ASSESSMENT_STARTED
  ASSESSMENT_COMPLETED

  @@map("conversion_stage")
}

// ---------------------------------------------------------------------------
// Internal app users (staff — separate from ABTalks students)
// ---------------------------------------------------------------------------

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  hashedPassword String   @map("hashed_password")
  role           Role     @default(VIEWER)
  isActive       Boolean  @default(true) @map("is_active")
  // Which brands (Brand.key) this person can send as and see data for.
  // allSenders = every brand, including ones added later. Admins always see all.
  allSenders      Boolean  @default(true) @map("all_senders")
  senderBrandKeys String[] @default([]) @map("sender_brand_keys")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  campaigns   Campaign[]
  importJobs  ImportJob[]
  auditLogs   AuditLog[]
  createdTemplates          EmailTemplate[]        @relation("template_created_by")
  createdTransactionalTpls  TransactionalTemplate[] @relation("txn_template_created_by")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Marketing contacts (external prospects) — unique on normalized email
// ---------------------------------------------------------------------------

model MarketingContact {
  id                 String        @id @default(cuid())
  email              String        @unique // ALWAYS lowercased on write (see normalizeEmail)
  firstName          String?       @map("first_name")
  lastName           String?       @map("last_name")
  phone              String?
  college            String?
  branch             String?
  year               String?
  graduationYear     Int?          @map("graduation_year")
  registrationStatus String?       @map("registration_status") // e.g. NOT_REGISTERED / REGISTERED
  company            String?
  // STUDENT / PROFESSIONAL / RECRUITER / UNKNOWN — set by Klymb list refreshes.
  userType           String?       @map("user_type")
  klymbUserId        String?       @map("klymb_user_id")
  source             ContactSource @default(IMPORT)
  consentStatus      ConsentStatus @default(IMPLIED) @map("consent_status")
  consentDate        DateTime?     @map("consent_date")
  meta               Json?         // arbitrary extra CSV columns preserved as JSON

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tags        ContactTagOnContact[]
  lists       ContactListMember[]
  emailJobs   EmailJob[]
  conversions ConversionEvent[]

  @@index([college, branch, year])
  @@index([registrationStatus])
  @@index([consentStatus])
  @@index([createdAt])
  @@index([userType])
  @@index([klymbUserId])
  @@map("marketing_contacts")
}

// Read-only projection of ABTalks main users; NOT the source of truth.
// Refreshed via a scheduled sync job. Keyed by upstream id + normalized email.
model RegisteredUserRef {
  id            String   @id @default(cuid())
  abtalksUserId String   @unique @map("abtalks_user_id")
  email         String   @unique
  firstName     String?  @map("first_name")
  lastName      String?  @map("last_name")
  college       String?
  branch        String?
  year          String?
  syncedAt      DateTime @default(now()) @map("synced_at")

  emailJobs   EmailJob[]
  conversions ConversionEvent[]

  @@index([college, branch, year])
  @@map("registered_user_refs")
}

model ContactTag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  contacts ContactTagOnContact[]

  @@map("contact_tags")
}

model ContactTagOnContact {
  contactId String @map("contact_id")
  tagId     String @map("tag_id")

  contact MarketingContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     ContactTag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tag_on_contact")
}

// Named contact lists — the Brevo "Lists" concept. A contact can belong to
// many lists (Candidates, Recruiters, Hackathon Participants, etc.). Lists
// carry a color so the UI can render them as distinctive chips, and a source
// (manual / import / api) so we know how the list was populated.
model ContactList {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("emerald") // one of: emerald / teal / sky / amber / rose / violet / slate
  kind        ContactListKind @default(STATIC)
  // KLYMB lists only: the audience filter (src/server/klymb/filter.ts).
  klymbFilter Json?     @map("klymb_filter")
  syncedAt    DateTime? @map("synced_at")
  // Last refresh: { matched, added, removed, updated, byType, ms }.
  syncStats   Json?     @map("sync_stats")
  // Last refresh failure, cleared by the next successful one.
  syncError   String?   @map("sync_error")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members   ContactListMember[]
  overrides ContactListOverride[]
  campaigns Campaign[]

  @@map("contact_lists")
}

// Hand-made exceptions on a KLYMB list: INCLUDE adds an address whatever the
// filter says, EXCLUDE keeps one out even when the filter matches it. Stored
// by address so they survive refreshes and contacts being re-created.
model ContactListOverride {
  listId    String           @map("list_id")
  email     String // normalized (lowercased)
  mode      ListOverrideMode
  createdAt DateTime         @default(now()) @map("created_at")

  list ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([listId, email])
  @@map("contact_list_overrides")
}

model ContactListMember {
  contactId String   @map("contact_id")
  listId    String   @map("list_id")
  addedAt   DateTime @default(now()) @map("added_at")

  contact MarketingContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  list    ContactList      @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([contactId, listId])
  @@index([listId])
  @@map("contact_list_members")
}

// ---------------------------------------------------------------------------
// Segments
// ---------------------------------------------------------------------------

model Segment {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  // JSON tree of conditions (AND/OR nested). Evaluated server-side and
  // compiled into a Prisma `where` before campaign creation.
  rules        Json
  audienceSize Int?     @map("audience_size") // cached last-computed size
  computedAt   DateTime? @map("computed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  campaigns Campaign[]

  @@map("segments")
}

// ---------------------------------------------------------------------------
// Templates
// ---------------------------------------------------------------------------

// Marketing templates — Unlayer visual editor
model EmailTemplate {
  id           String   @id @default(cuid())
  // Brand.key this template belongs to; null = shared by every brand.
  brandKey     String?  @map("brand_key")
  name         String
  category     String   // Placement Drive / Workshop / Hackathon / Newsletter / etc.
  subject      String
  previewText  String?  @map("preview_text")
  designJson   Json     @map("design_json") // Unlayer design blob
  html         String   @db.Text // compiled HTML
  variables    String[] // declared personalization keys (first_name, college, ...)
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  createdBy User?      @relation("template_created_by", fields: [createdById], references: [id])
  campaigns Campaign[]

  @@index([category])
  @@map("email_templates")
}

// Transactional templates — keyed by template_key, versioned, immutable rows.
// `active` row per key is the one used at send time.
model TransactionalTemplate {
  id            String        @id @default(cuid())
  templateKey   String        @map("template_key") // e.g. welcome_email
  version       Int           @default(1)
  name          String
  subject       String
  html          String        @db.Text
  text          String?       @db.Text
  variables     String[]      // declared required variables
  category      EmailCategory @default(TRANSACTIONAL_NONESSENTIAL)
  isActive      Boolean       @default(false) @map("is_active")
  createdById   String?       @map("created_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  createdBy User? @relation("txn_template_created_by", fields: [createdById], references: [id])
  rules     EmailEventRule[]

  @@unique([templateKey, version])
  @@index([templateKey, isActive])
  @@map("transactional_templates")
}

// Event → template mapping. Triggered by ABTalks main app via HMAC API.
model EmailEventRule {
  id               String   @id @default(cuid())
  eventType        String   @unique @map("event_type") // e.g. USER_REGISTERED
  description      String?
  templateKey      String   @map("template_key")
  isActive         Boolean  @default(true) @map("is_active")
  requiredVars     String[] @map("required_vars")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  templates TransactionalTemplate[]

  @@map("email_event_rules")
}

// ---------------------------------------------------------------------------
// Campaigns
// ---------------------------------------------------------------------------

model Campaign {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique // used in UTM utm_campaign
  subject        String
  previewText    String?        @map("preview_text")
  fromName       String         @map("from_name")
  fromEmail      String         @map("from_email")
  replyTo        String?        @map("reply_to")

  status         CampaignStatus @default(DRAFT)
  templateId     String?        @map("template_id")
  segmentId      String?        @map("segment_id")
  // First selected list (kept for display/back-compat); listIds holds every
  // selected list. Older campaigns have listId set and listIds empty.
  listId         String?        @map("list_id")
  listIds        String[]       @default([]) @map("list_ids")

  scheduledAt    DateTime?      @map("scheduled_at")
  startedAt      DateTime?      @map("started_at")
  // Set when the launcher has queued every recipient; COMPLETED waits for it.
  fanoutCompletedAt DateTime?   @map("fanout_completed_at")
  // Template HTML frozen at launch; each recipient's body is rendered from it
  // at delivery time instead of storing a full copy per email job.
  htmlSnapshot   String?        @db.Text @map("html_snapshot")
  // Campaign-only design (pasted HTML) used instead of a library template.
  customHtml     String?        @db.Text @map("custom_html")
  // Optional conversion goal: { kind, ref? } (src/server/conversions/kinds.ts).
  // Without one, any Klymb action counts as a conversion.
  conversionGoal Json?          @map("conversion_goal")
  completedAt    DateTime?      @map("completed_at")
  cancelledAt    DateTime?      @map("cancelled_at")

  totalRecipients Int           @default(0) @map("total_recipients")
  sentCount       Int           @default(0) @map("sent_count")
  deliveredCount  Int           @default(0) @map("delivered_count")
  bouncedCount    Int           @default(0) @map("bounced_count")
  complainedCount Int           @default(0) @map("complained_count")
  openedCount     Int           @default(0) @map("opened_count")
  clickedCount    Int           @default(0) @map("clicked_count")
  unsubscribedCount Int         @default(0) @map("unsubscribed_count")

  createdById    String?        @map("created_by_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  template   EmailTemplate?      @relation(fields: [templateId], references: [id])
  segment    Segment?            @relation(fields: [segmentId], references: [id])
  list       ContactList?        @relation(fields: [listId], references: [id])
  createdBy  User?               @relation(fields: [createdById], references: [id])
  recipients CampaignRecipient[]
  jobs       EmailJob[]
  conversions ConversionEvent[]

  @@index([status])
  @@index([scheduledAt])
  @@map("campaigns")
}

// One row per recipient per campaign. UNIQUE ensures a retry can't create a
// second row for the same (campaign, contact) pair.
model CampaignRecipient {
  id            String   @id @default(cuid())
  campaignId    String   @map("campaign_id")
  emailJobId    String?  @unique @map("email_job_id")
  contactId     String?  @map("contact_id")            // MarketingContact.id if applicable
  registeredUserRefId String? @map("registered_user_ref_id")
  email         String                                  // snapshot at send time
  variables     Json                                    // resolved personalization payload
  createdAt     DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  emailJob EmailJob? @relation(fields: [emailJobId], references: [id])

  @@unique([campaignId, email])
  @@index([campaignId])
  @@map("campaign_recipients")
}

// ---------------------------------------------------------------------------
// EmailJob — the unified send unit for both marketing and transactional.
// idempotencyKey is UNIQUE: a retry with the same key never sends twice.
// ---------------------------------------------------------------------------

model EmailJob {
  id              String         @id @default(cuid())
  idempotencyKey  String         @unique @map("idempotency_key")

  emailType       EmailType      @map("email_type")
  category        EmailCategory
  status          EmailJobStatus @default(PENDING)

  // Recipient (denormalized snapshot — the ABTalks user or Contact may change/delete later)
  recipientEmail  String         @map("recipient_email")
  contactId       String?        @map("contact_id")
  registeredUserRefId String?    @map("registered_user_ref_id")

  // Template routing
  campaignId      String?        @map("campaign_id")
  // Personal mails batch this job came from, and the files sent with it.
  directSendId    String?        @map("direct_send_id")
  attachmentIds   String[]       @default([]) @map("attachment_ids")
  templateKey     String?        @map("template_key")       // for transactional
  templateVersion Int?           @map("template_version")   // for transactional
  emailTemplateId String?        @map("email_template_id")  // for marketing

  // Trigger provenance
  eventType       String?        @map("event_type") // e.g. USER_REGISTERED
  eventId         String?        @map("event_id")   // caller-supplied idempotency id

  // Rendered content snapshot (kept for auditability / retries)
  subject         String
  fromEmail       String         @map("from_email")
  fromName        String         @map("from_name")
  replyTo         String?        @map("reply_to")
  variables       Json           // resolved variables
  renderedHtml    String?        @db.Text @map("rendered_html")
  renderedText    String?        @db.Text @map("rendered_text")

  // Delivery result
  providerMessageId String?      @map("provider_message_id")
  errorCode         String?      @map("error_code")
  errorMessage      String?      @db.Text @map("error_message")

  attempts        Int            @default(0)
  scheduledFor    DateTime?      @map("scheduled_for")
  queuedAt        DateTime?      @map("queued_at")
  sentAt          DateTime?      @map("sent_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  campaign         Campaign?          @relation(fields: [campaignId], references: [id])
  contact          MarketingContact?  @relation(fields: [contactId], references: [id])
  registeredRef    RegisteredUserRef? @relation(fields: [registeredUserRefId], references: [id])
  campaignRecipient CampaignRecipient?
  logs             EmailLog[]
  events           EmailEvent[]

  @@index([emailType, status])
  @@index([status, scheduledFor])
  @@index([campaignId])
  @@index([directSendId])
  @@index([recipientEmail])
  @@index([providerMessageId])
  @@map("email_jobs")
}

// One row per attempt/state-change. Provides an authoritative send history.
model EmailLog {
  id                String   @id @default(cuid())
  jobId             String   @map("job_id")
  attempt           Int
  providerMessageId String?  @map("provider_message_id")
  status            EmailJobStatus
  errorCode         String?  @map("error_code")
  errorMessage      String?  @db.Text @map("error_message")
  sentAt            DateTime? @map("sent_at")
  deliveredAt       DateTime? @map("delivered_at")
  bouncedAt         DateTime? @map("bounced_at")
  complainedAt      DateTime? @map("complained_at")
  openedAt          DateTime? @map("opened_at")
  clickedAt         DateTime? @map("clicked_at")
  createdAt         DateTime @default(now()) @map("created_at")

  job EmailJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([providerMessageId])
  @@map("email_logs")
}

// Normalized SES events from the SNS webhook.
model EmailEvent {
  id                String         @id @default(cuid())
  jobId             String?        @map("job_id")
  providerMessageId String?        @map("provider_message_id")
  type              EmailEventType
  raw               Json           // full SES event JSON for audit
  createdAt         DateTime       @default(now()) @map("created_at")

  job EmailJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([providerMessageId])
  @@index([jobId, type])
  @@map("email_events")
}

// ---------------------------------------------------------------------------
// Suppression & unsubscribe
// ---------------------------------------------------------------------------

// (email, category, brandKey) is unique. Essential transactional emails only
// bypass when the reason is not HARD_BOUNCE (a hard bounce means the mailbox
// is dead and even essential mail cannot land).
//
// brandKey scopes unsubscribes and complaints to one brand (Brand.key), so
// leaving Klymb's marketing doesn't stop ABTalks' and vice versa. "" means
// every brand: hard bounces and manual blocks.
model Suppression {
  id        String            @id @default(cuid())
  email     String
  category  EmailCategory
  brandKey  String            @default("") @map("brand_key")
  reason    SuppressionReason
  note      String?
  createdAt DateTime          @default(now()) @map("created_at")

  @@unique([email, category, brandKey])
  @@index([email])
  @@map("suppressions")
}

// A sending identity: one domain verified in SES, the From addresses allowed
// on it, and the name shown in footers and on the unsubscribe pages. A job's
// brand is the one whose domain matches its From address.
model Brand {
  id            String    @id @default(cuid())
  key           String    @unique // "klymb", "abtalks" — stored on suppressions
  name          String // "Klymb", "ABTalks"
  domain        String    @unique // "klymb.ai"
  fromName      String    @map("from_name")
  fromAddresses String[]  @map("from_addresses") // ["team@klymb.ai", "no-reply@klymb.ai"]
  replyTo       String?   @map("reply_to")
  websiteUrl    String?   @map("website_url")
  isDefault     Boolean   @default(false) @map("is_default")
  sesVerified   Boolean   @default(false) @map("ses_verified")
  sesCheckedAt  DateTime? @map("ses_checked_at")
  sesStatus     String?   @map("ses_status") // last check, human readable
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("brands")
}

model UnsubscribeToken {
  id         String        @id @default(cuid())
  token      String        @unique
  email      String
  category   EmailCategory @default(MARKETING)
  campaignId String?       @map("campaign_id")
  usedAt     DateTime?     @map("used_at")
  expiresAt  DateTime      @map("expires_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([email])
  @@map("unsubscribe_tokens")
}

// ---------------------------------------------------------------------------
// Personal mails — a CSV of (email, subject, body, attachments) sent one by one
// ---------------------------------------------------------------------------

model DirectSend {
  id          String           @id @default(cuid())
  name        String
  status      DirectSendStatus @default(DRAFT)
  kind        DirectSendKind   @default(PERSONAL)
  fromName    String           @map("from_name")
  fromEmail   String           @map("from_email")
  replyTo     String?          @map("reply_to")
  totalRows   Int              @default(0) @map("total_rows")
  createdById String?          @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  startedAt   DateTime?        @map("started_at")
  completedAt DateTime?        @map("completed_at")

  rows        DirectSendRow[]
  attachments MailAttachment[]

  @@index([createdAt])
  @@map("direct_sends")
}

model DirectSendRow {
  id              String   @id @default(cuid())
  directSendId    String   @map("direct_send_id")
  rowNumber       Int      @map("row_number") // 1-based, as in the CSV
  email           String
  name            String?
  subject         String
  body            String   @db.Text // as written in the CSV (plain text or HTML)
  // Every CSV column, for {{column}} personalization.
  variables       Json
  // File names from the CSV's attachment column.
  attachmentNames String[] @default([]) @map("attachment_names")
  emailJobId      String?  @unique @map("email_job_id")

  directSend DirectSend @relation(fields: [directSendId], references: [id], onDelete: Cascade)

  @@unique([directSendId, rowNumber])
  @@index([directSendId])
  @@map("direct_send_rows")
}

// Files uploaded for a personal-mails batch. Stored in the database so the
// delivery worker can attach them; deleted with the batch.
model MailAttachment {
  id           String   @id @default(cuid())
  directSendId String   @map("direct_send_id")
  filename     String
  contentType  String   @map("content_type")
  size         Int
  // Attached to every email in the batch, not only rows that name it.
  forAll       Boolean  @default(false) @map("for_all")
  data         Bytes
  createdAt    DateTime @default(now()) @map("created_at")

  directSend DirectSend @relation(fields: [directSendId], references: [id], onDelete: Cascade)

  @@unique([directSendId, filename])
  @@map("mail_attachments")
}

// ---------------------------------------------------------------------------
// Imports
// ---------------------------------------------------------------------------

model ImportJob {
  id          String          @id @default(cuid())
  filename    String
  fileUrl     String?         @map("file_url") // upload location (Vercel Blob / S3)
  status      ImportJobStatus @default(PENDING)
  totalRows   Int             @default(0) @map("total_rows")
  processed   Int             @default(0)
  imported    Int             @default(0)
  duplicates  Int             @default(0)
  invalid     Int             @default(0)
  skipped     Int             @default(0)
  columnMap   Json?           @map("column_map")
  error       String?         @db.Text
  createdById String?         @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  completedAt DateTime?       @map("completed_at")

  createdBy User?             @relation(fields: [createdById], references: [id])
  errors    ImportRowError[]

  @@index([status])
  @@map("import_jobs")
}

model ImportRowError {
  id          String   @id @default(cuid())
  importJobId String   @map("import_job_id")
  rowNumber   Int      @map("row_number")
  rowData     Json     @map("row_data")
  reason      String
  createdAt   DateTime @default(now()) @map("created_at")

  job ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@map("import_row_errors")
}

// What each non-admin role may do (src/server/access/permissions.ts). A role
// without a row uses the built-in defaults; admins can always do everything.
model RolePermission {
  role        Role     @id
  permissions String[]
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String   // e.g. "campaign.create", "contact.import", "campaign.pause"
  resource   String?  // e.g. "campaign:abc123"
  ip         String?
  userAgent  String?  @map("user_agent") @db.Text
  metadata   Json?
  result     String?  // "success" | "failure"
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Attributed conversions — recomputed from the Klymb database
// ---------------------------------------------------------------------------

// One row per Klymb action (signup, registration, enrollment, …) credited to
// the last campaign / personal mail its person received in the 7 days before
// it. Rebuilt wholesale by each refresh (src/server/conversions/refresh.ts).
model AttributedConversion {
  id           String   @id @default(cuid())
  campaignId   String?  @map("campaign_id")
  directSendId String?  @map("direct_send_id")
  emailJobId   String   @map("email_job_id")
  // Sender of the credited email, for per-brand access.
  fromEmail    String   @default("") @map("from_email")
  email        String
  // SIGNUP | WORKSHOP | HACKATHON | VIDEOTHON | COHORT | JOB | MOCK_INTERVIEW
  kind         String
  // Event / cohort / job id the action was about, when there is one.
  ref          String?
  label        String
  actionAt     DateTime @map("action_at")
  sentAt       DateTime @map("sent_at")
  // The person clicked a link in the email before acting.
  clicked      Boolean

  @@index([campaignId])
  @@index([directSendId])
  @@index([actionAt])
  @@map("attributed_conversions")
}

model ConversionRun {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  windowDays  Int       @map("window_days")
  sends       Int       @default(0)
  actions     Int       @default(0)
  conversions Int       @default(0)
  error       String?   @db.Text

  @@index([startedAt])
  @@map("conversion_runs")
}

// ---------------------------------------------------------------------------
// Conversion attribution (email → registration → assessment)
// ---------------------------------------------------------------------------

model ConversionEvent {
  id                  String          @id @default(cuid())
  campaignId          String?         @map("campaign_id")
  campaignSlug        String?         @map("campaign_slug") // captured from utm_campaign
  contactId           String?         @map("contact_id")
  registeredUserRefId String?         @map("registered_user_ref_id")
  email               String?
  stage               ConversionStage
  metadata            Json?
  occurredAt          DateTime        @map("occurred_at")
  createdAt           DateTime        @default(now()) @map("created_at")

  campaign      Campaign?          @relation(fields: [campaignId], references: [id])
  contact       MarketingContact?  @relation(fields: [contactId], references: [id])
  registeredRef RegisteredUserRef? @relation(fields: [registeredUserRefId], references: [id])

  @@index([campaignId, stage])
  @@index([email])
  @@map("conversion_events")
}
