{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "prisma generate && next build",
  "framework": "nextjs",
  "regions": ["bom1"],
  "functions": {
    "src/app/api/qstash/deliver/route.ts": { "maxDuration": 60 },
    "src/app/api/qstash/campaigns/launch/route.ts": { "maxDuration": 300 },
    "src/app/(app)/marketing/contacts/actions.ts": { "maxDuration": 300 },
    "src/app/api/webhooks/ses/route.ts": { "maxDuration": 30 }
  }
}
