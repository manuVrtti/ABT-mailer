# -----------------------------------------------------------------------------
# ABTalks Email Infrastructure — environment variables
# Copy to .env.local for local development. NEVER commit .env or .env.local.
# The temporary Vercel URL and the future mail.abtalks.in URL are BOTH driven
# by NEXT_PUBLIC_APP_URL only — no domain is hardcoded anywhere in the code.
# -----------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Auth (NextAuth Credentials) --------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# --- This project's Postgres (Neon) -----------------------------------------
# Pooled connection for the app (add ?sslmode=require&pgbouncer=true&connection_limit=1)
DATABASE_URL=
# Direct connection for Prisma migrations
DIRECT_URL=

# --- ABTalks main platform (read-only bridge) -------------------------------
# Read-only Postgres role scoped to a users view. Optional until Phase 4.
ABTALKS_DB_URL=

# --- Amazon SES (ap-south-1 Mumbai) -----------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=no-reply@mail.abtalks.in
SES_FROM_NAME=ABTalks
SES_REPLY_TO=support@abtalks.in
SES_CONFIGURATION_SET=abtalks-mailer

# --- SNS webhook (SES event ingest) -----------------------------------------
SNS_WEBHOOK_SECRET=change-me

# --- Upstash QStash (queue) -------------------------------------------------
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_QUEUE_TRANSACTIONAL=priority
QSTASH_QUEUE_MARKETING=bulk

# --- Internal transactional API (called by ABTalks main app) ----------------
TRANSACTIONAL_API_HMAC_SECRET=change-me

# --- Tokens -----------------------------------------------------------------
UNSUBSCRIBE_TOKEN_SECRET=change-me

# --- SES cost estimate (₹ per 1000 or $ per 1000, configurable per §28) -----
# Amazon SES ap-south-1 outside free tier is roughly $0.10 per 1000 emails.
SES_COST_PER_THOUSAND_USD=0.10
